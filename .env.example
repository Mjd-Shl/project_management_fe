VITE_PROJECTS_LIST_METHOD=
VITE_WORKSPACE_MEMBERS_URL=
VITE_WORKSPACE_MEMBERS_METHOD=
VITE_PROJECT_CREATE_URL=
VITE_PROJECT_CREATE_METHOD=
VITE_PROJECT_UPDATE_URL=
VITE_PROJECT_UPDATE_METHOD=
VITE_PROJECT_ARCHIVE_URL=
VITE_PROJECT_ARCHIVE_METHOD=
VITE_PROJECT_RESTORE_URL=
VITE_PROJECT_RESTORE_METHOD=
